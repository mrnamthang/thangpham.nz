---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/global.css';
import { site } from '../site.config';

interface Props {
  title: string;
  description: string;
  // Let main be wider than the text column (the About page puts a photo beside the text).
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const path = Astro.url.pathname;
const isHome = path === '/';
---

<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f4f1ea" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_NZ" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-10 focus:bg-paper focus:px-3 focus:py-1"
    >
      Skip to content
    </a>

    <div class="px-6 sm:px-10 lg:ml-[12vw] lg:px-0">
      <header class="measure flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2 pt-10 pb-6">
        {/* On the home page the name is the h1, so the header only shows the nav. */}
        {!isHome && <a href="/" class="font-medium text-ink no-underline hover:underline">{site.name}</a>}
        <nav aria-label="Main" class:list={[isHome && 'sm:ml-auto']}>
          <ul class="flex flex-wrap gap-x-5 gap-y-1 text-base">
            {
              site.nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined} class="aria-[current=page]:text-ink">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </header>

      <main id="main" class:list={['pb-20', wide ? 'xl:max-w-[calc(64ch+18rem)]' : 'measure']}>
        <slot />
      </main>

      <footer class="measure label border-t border-line pt-6 pb-12">
        <p>{site.name} · {site.nativeName}</p>
        <p>{site.location}</p>
        <p class="mt-2 flex flex-wrap gap-x-4">
          <a href={site.links.github} rel="me">GitHub</a>
          <a href={site.links.linkedin} rel="me">LinkedIn</a>
          <a href={site.links.upwork} rel="me">Upwork</a>
        </p>
      </footer>
    </div>
  </body>
</html>
