---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import WorkList from '../components/WorkList.astro';
import ContactLine from '../components/ContactLine.astro';

const home = (await getEntry('pages', 'home'))!.data;
const work = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title={home.title} description={home.description}>
  <section class="pt-10">
    <h1>{home.heading}</h1>
    <p class="mt-2">{home.intro}</p>
  </section>

  <p class="mt-10">{home.proof}</p>
  <p class="mt-5">{home.who}</p>

  <section aria-labelledby="work" class="mt-16">
    <h2 id="work" class="mb-6">{home.workHeading}</h2>
    <WorkList items={work} />
  </section>

  {
    home.example && (
      <section aria-labelledby="example" class="mt-16">
        <h2 id="example">{home.exampleHeading}</h2>
        <p class="mt-3">
          {home.example} <a href="/case-studies/performance/">More on the performance work</a>.
        </p>
      </section>
    )
  }

  {
    home.now && (
      <section aria-labelledby="now" class="mt-16">
        <h2 id="now" class="flex items-baseline gap-3">
          Now {home.nowDate && <span class="label font-normal">{home.nowDate}</span>}
        </h2>
        <p class="mt-3">{home.now}</p>
      </section>
    )
  }

  <section aria-labelledby="contact" class="mt-16">
    <h2 id="contact" class="mb-3">Contact</h2>
    <ContactLine />
  </section>
</Layout>
