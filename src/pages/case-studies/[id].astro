---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ContactLine from '../../components/ContactLine.astro';
import { site } from '../../site.config';

export async function getStaticPaths() {
  const items = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
  return items.map((item, i) => ({
    params: { id: item.id },
    props: { item, next: items[(i + 1) % items.length] },
  }));
}

const { item, next } = Astro.props as {
  item: CollectionEntry<'caseStudies'>;
  next: CollectionEntry<'caseStudies'>;
};
const { Content } = await render(item);
const { data } = item;
---

<Layout title={`${data.title} | ${site.name}`} description={`${data.summary} ${data.result}`}>
  <article>
    <header class="pt-10 pb-2">
      <p class="label">{data.client}</p>
      <h1 class="mt-2">{data.title}</h1>
      <p class="mt-4">{data.summary}</p>
    </header>

    <div class="flow">
      <Content />
      <h2>Stack</h2>
      <p>{data.stack}</p>
    </div>
  </article>

  <div class="mt-16 space-y-4 border-t border-line pt-6">
    <ContactLine />
    {next.id !== item.id && (
      <p>
        Next: <a href={`/case-studies/${next.id}/`}>{next.data.title}</a>
      </p>
    )}
  </div>
</Layout>
