---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ContactCta from '../../components/ContactCta.astro';
import { site } from '../../site.config';

export async function getStaticPaths() {
  const items = await getCollection('caseStudies');
  return items.map((item) => ({ params: { id: item.id }, props: { item } }));
}

const { item } = Astro.props as { item: CollectionEntry<'caseStudies'> };
const { Content } = await render(item);
const { data } = item;
---

<Layout title={`${data.title} | ${site.name}`} description={data.summary}>
  <article class="max-w-3xl">
    <header class="pt-16 pb-10 sm:pt-24">
      <p><a href="/case-studies/" class="text-sm">Case studies</a></p>
      <p class="mt-8 text-sm text-muted">{data.client}</p>
      <h1 class="mt-3 text-4xl leading-tight font-medium tracking-tight sm:text-5xl">{data.title}</h1>
      <p class="mt-6 text-lg leading-relaxed text-ink/85">{data.summary}</p>
      <div class="mt-8 border-t border-line pt-4">
        <h2 class="font-sans text-sm font-semibold">Tech used</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {data.tech.map((t) => <li class="rounded-sm bg-paper-deep px-2 py-0.5 text-sm">{t}</li>)}
        </ul>
      </div>
    </header>

    <div class="prose prose-lg max-w-none prose-h2:mt-12 prose-h2:text-2xl">
      <Content />
    </div>
  </article>

  <ContactCta />
</Layout>
