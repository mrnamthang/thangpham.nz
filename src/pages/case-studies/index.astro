---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CaseStudyList from '../../components/CaseStudyList.astro';
import ContactCta from '../../components/ContactCta.astro';

const page = (await getEntry('pages', 'case-studies'))!.data;
const items = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title={page.title} description={page.description}>
  <PageHeader heading={page.heading} intro={page.intro} />
  <CaseStudyList items={items} headingLevel="h2" />
  <ContactCta />
</Layout>
