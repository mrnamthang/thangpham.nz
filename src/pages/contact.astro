---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../site.config';

const page = (await getEntry('pages', 'contact'))!.data;
const formAction = site.formspreeId ? `https://formspree.io/f/${site.formspreeId}` : '';
const field =
  'mt-1 block w-full rounded-none border border-ink/30 bg-white/50 px-3 py-2 text-base text-ink focus:border-moss focus:outline-none focus-visible:outline-2 focus-visible:outline-moss';
---

<Layout title={page.title} description={page.description}>
  <PageHeader heading={page.heading} intro={page.intro} />

  <div class="space-y-4">
    <p>Email me at <a href={`mailto:${site.email}`}>{site.email}</a>. {site.replyTime}</p>
    {site.bookingUrl && <p>If you'd rather talk, <a href={site.bookingUrl}>book a call on Calendly</a>.</p>}
    <p>I'm in Vietnam (UTC+7) and work NZ and AU business hours.</p>
  </div>

  {
    formAction && (
      <section aria-labelledby="form-heading" class="mt-14">
        <h2 id="form-heading">Or send a message here</h2>

        <form id="contact-form" action={formAction} method="POST" class="mt-6 space-y-5">
          <div>
            <label for="name">Name</label>
            <input id="name" name="name" type="text" autocomplete="name" required class={field} />
          </div>
          <div>
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required class={field} />
          </div>
          <div>
            <label for="company">
              Company <span class="text-muted">(optional)</span>
            </label>
            <input id="company" name="company" type="text" autocomplete="organization" class={field} />
          </div>
          <div>
            <label for="message">What do you need help with?</label>
            <textarea id="message" name="message" rows="6" required class={field} />
          </div>
          <input type="hidden" name="_subject" value="New message from thangpham.nz" />
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <button type="submit" class="border border-ink bg-ink px-5 py-2 text-paper hover:bg-ink/85 disabled:opacity-60">
            Send message
          </button>
          <p id="form-status" role="status" aria-live="polite" class="text-base"></p>
        </form>

        <div id="form-success" hidden class="mt-6 border-l-2 border-moss py-2 pl-5">
          <h3 id="form-success-heading" tabindex="-1" class="text-[1.3rem] focus:outline-none">
            Thanks, your message was sent.
          </h3>
          <p class="mt-2">
            I will reply to <strong id="form-success-email" class="font-medium">your email</strong> within one working
            day, NZ time.
          </p>
          <p class="mt-4">
            <a id="form-again" href="#contact-form">Send another message</a>
          </p>
        </div>
      </section>
    )
  }
</Layout>

<script>
  // Send the form without leaving the page. Without JavaScript the form still posts normally.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  const success = document.getElementById('form-success');
  const successHeading = document.getElementById('form-success-heading');
  const successEmail = document.getElementById('form-success-email');
  const again = document.getElementById('form-again');

  function showStatus(message: string, isError = false) {
    if (!status) return;
    status.textContent = message;
    status.className = isError ? 'border-l-2 border-red-800 pl-4 text-base text-red-900' : 'text-base text-muted';
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector('button');
    if (button) button.disabled = true;
    showStatus('Sending...');

    try {
      const data = new FormData(form);
      const response = await fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error();

      if (successEmail) successEmail.textContent = String(data.get('email') || 'your email');
      form.reset();
      showStatus('');
      form.hidden = true;
      if (success) success.hidden = false;
      successHeading?.focus();
    } catch {
      showStatus('Sorry, the message could not be sent. Please email me instead.', true);
    } finally {
      if (button) button.disabled = false;
    }
  });

  again?.addEventListener('click', (event) => {
    event.preventDefault();
    if (success) success.hidden = true;
    if (form) {
      form.hidden = false;
      form.querySelector('input')?.focus();
    }
  });
</script>
