---
interface Props {
  heading: string;
  intro?: string;
}

const { heading, intro } = Astro.props;
---

<header class="max-w-3xl pt-20 pb-12 sm:pt-28 sm:pb-16">
  <h1 class="text-4xl font-medium tracking-tight sm:text-5xl">{heading}</h1>
  {intro && <p class="mt-6 text-lg leading-relaxed text-muted">{intro}</p>}
</header>
