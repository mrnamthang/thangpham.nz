---
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'caseStudies'>[];
  headingLevel?: 'h2' | 'h3';
}

const { items, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<ul class="divide-y divide-line border-y border-line">
  {
    items.map((item) => (
      <li class="group relative grid gap-3 py-8 sm:grid-cols-[14rem_1fr] sm:gap-10">
        <p class="text-sm text-muted">{item.data.client}</p>
        <div>
          <Heading class="text-xl font-medium sm:text-2xl">
            <a
              href={`/case-studies/${item.id}/`}
              class="text-ink no-underline after:absolute after:inset-0 group-hover:text-accent"
            >
              {item.data.title}
            </a>
          </Heading>
          <p class="mt-3 max-w-2xl leading-relaxed text-muted">{item.data.summary}</p>
          <ul class="mt-4 flex flex-wrap gap-2" aria-label="Tech used">
            {item.data.tech.map((t) => (
              <li class="rounded-sm bg-paper-deep px-2 py-0.5 text-xs text-ink">{t}</li>
            ))}
          </ul>
        </div>
      </li>
    ))
  }
</ul>
