---
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'caseStudies'>[];
  headingLevel?: 'h2' | 'h3';
}

const { items, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<ul class="space-y-9">
  {
    items.map((item) => (
      <li>
        <p class="label">{item.data.client}</p>
        <Heading class="mt-1 text-[1.1rem]">
          <a href={`/case-studies/${item.id}/`}>{item.data.title}</a>
        </Heading>
        <p class="mt-2">
          {item.data.summary} {item.data.result}
        </p>
      </li>
    ))
  }
</ul>
