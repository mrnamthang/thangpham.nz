---
import { getEntry } from 'astro:content';
import Button from './Button.astro';
import { site } from '../site.config';

// Uses the call-to-action text from the home page content.
const home = (await getEntry('pages', 'home'))!.data;
const bookHref = site.bookingUrl || '/contact/';
---

<section aria-labelledby="cta-heading" class="mt-24 rounded-sm bg-paper-deep px-6 py-12 sm:px-12 sm:py-16">
  <h2 id="cta-heading" class="text-2xl font-medium sm:text-3xl">{home.ctaHeading}</h2>
  <p class="mt-4 max-w-xl leading-relaxed text-muted">{home.ctaText}</p>
  <div class="mt-8 flex flex-wrap gap-3">
    <Button href={bookHref}>Book a call</Button>
    <Button href="/contact/" variant="secondary">Send a message</Button>
  </div>
  <p class="mt-6 text-sm text-muted">
    Or email <a href={`mailto:${site.email}`}>{site.email}</a>
  </p>
</section>
