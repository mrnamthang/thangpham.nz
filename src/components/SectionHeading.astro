---
interface Props {
  number: string;
  id: string;
}

const { number, id } = Astro.props;
---

<div class="mb-10 flex items-baseline gap-4 border-t border-line pt-6">
  <span class="font-serif text-sm text-accent" aria-hidden="true">{number}</span>
  <h2 id={id} class="text-2xl font-medium sm:text-3xl"><slot /></h2>
</div>
