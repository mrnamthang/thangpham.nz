---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
}

const { href, variant = 'primary' } = Astro.props;
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center rounded-sm px-5 py-3 text-[15px] font-medium no-underline transition-colors',
    variant === 'primary'
      ? 'bg-accent text-white hover:bg-accent-dark'
      : 'border border-ink/25 text-ink hover:border-ink',
  ]}
>
  <slot />
</a>
